# DryEyes BFF 環境変数

# BFF サーバーポート
PORT=3001

# changedetection.io 接続設定
CHANGEDETECTION_URL=http://localhost:5000
# Settings > API タブに表示される API キー
CHANGEDETECTION_API_KEY=

# 通知タップで開く DryEyes の URL
# 未設定なら LAN の IPv4 を自動検出して http://<LAN IP>:3010 を使う。
# スマホから到達できる必要があるため localhost は不可。
# 外出先からも開きたい場合は Tailscale などの URL を指定する。
# APP_BASE_URL=http://192.168.1.10:3010
# 画面 (Vite) のポート。APP_BASE_URL 未指定時の自動検出に使う。
APP_PORT=3010

# ntfy 通知設定
NTFY_URL=http://localhost:8085
NTFY_DEFAULT_TOPIC=dryeyes

# ログイン機能（ローカル運用前提の簡易認証）
# ユーザー情報とセッションの保存先（未指定なら backend/data）
# DATA_DIR=
# ブラウザに保持するログイントークンの有効期限（日数）
SESSION_TTL_DAYS=90
