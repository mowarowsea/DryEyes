# DryEyes BFF 環境変数

# BFF サーバーポート
PORT=3001

# changedetection.io 接続設定
CHANGEDETECTION_URL=http://localhost:5000
# Settings > API タブに表示される API キー
CHANGEDETECTION_API_KEY=

# 監視対象ピッカーのページ描画に使うブラウザ（クロールと同じ sockpuppetbrowser）。
# docker-compose がコンテナの 3000 番をホストの 3020 番へ出している。
# つながらないときは JS で描画される部分が出ない素の HTML にフォールバックする。
BROWSER_WS_URL=ws://localhost:3020

# 通知タップで開く DryEyes の URL
# 未設定なら LAN の IPv4 を自動検出して http://<LAN IP>:3010 を使う。
# スマホから到達できる必要があるため localhost は不可。
# 外出先からも開きたい場合は Tailscale などの URL を指定する。
# APP_BASE_URL=http://192.168.1.10:3010
# スマホの共有シートから登録したい場合は PWA のインストールが必要で、
# そのためには HTTPS で開ける必要がある。Tailscale なら次の 1 コマンドで用意できる:
#   tailscale serve --bg --set-path=/DryEyes http://127.0.0.1:3010/DryEyes
# （--set-path はプロキシ時にパスを取り除くため、転送先にも同じパスを付けて打ち消す。
#   画面側は vite.config.ts の base=/DryEyes/ と対応している）
# この場合はここもサブパス込みで指定する:
# APP_BASE_URL=https://<machine>.<tailnet>.ts.net/DryEyes
# 画面 (Vite) のポート。APP_BASE_URL 未指定時の自動検出に使う。
APP_PORT=3010

# PowerDowner（ダウンロード司令塔）への投入先
# 見つけた新着をここへ送る。トークンは PowerDowner の config.json の apiToken と同じ値。
POWERDOWNER_URL=http://127.0.0.1:3939
POWERDOWNER_TOKEN=

# ntfy 通知設定
NTFY_URL=http://localhost:8085
NTFY_DEFAULT_TOPIC=dryeyes

# ログイン機能（ローカル運用前提の簡易認証）
# ユーザー情報とセッションの保存先（未指定なら backend/data）
# DATA_DIR=
# ブラウザに保持するログイントークンの有効期限（日数）
SESSION_TTL_DAYS=90

# 蔵書の台帳 (Pinax)。投入設定の作者・作品名を棚の綴りから選ぶのに使う (読み取りのみ)
PINAX_URL=http://127.0.0.1:3838
